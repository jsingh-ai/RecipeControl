# Writable RecipeControl database. SQLite is convenient for fixture development.
APP_DATABASE_URL=sqlite:///./recipecontrol.db
APP_DB_PASSWORD=replace_me
APP_DB_ROOT_PASSWORD=replace_me

# fixture (default) or mysql
SOURCE_ADAPTER=fixture
SOURCE_DATABASE_URL=mysql+pymysql://readonly_user:replace_me@source-db.example.invalid:3306/collector

# Required only for SOURCE_ADAPTER=mysql. Use the real discovered identifiers.
SOURCE_MACHINE_TABLE=replace_me
SOURCE_MACHINE_ID_COLUMN=replace_me
SOURCE_MACHINE_NAME_COLUMN=replace_me
SOURCE_TAG_TABLE=replace_me
SOURCE_TAG_ID_COLUMN=replace_me
SOURCE_TAG_MACHINE_ID_COLUMN=replace_me
SOURCE_TAG_NAME_COLUMN=replace_me
SOURCE_TAG_TYPE_COLUMN=replace_me
SOURCE_TAG_UNITS_COLUMN=replace_me
SOURCE_SAMPLE_TABLE=replace_me
SOURCE_SAMPLE_ID_COLUMN=replace_me
SOURCE_SAMPLE_TAG_ID_COLUMN=replace_me
SOURCE_SAMPLE_TIME_COLUMN=sampled_at_utc
SOURCE_SAMPLE_VALUE_COLUMN=replace_me

MAX_ANALYSIS_DAYS=45
MAX_TREND_LOOKBACK_MINUTES=1440
LIVE_FINALIZATION_LAG_MINUTES=2
NOTE_MAX_LENGTH=4000
LOG_LEVEL=INFO
VITE_API_URL=http://localhost:8000/api
