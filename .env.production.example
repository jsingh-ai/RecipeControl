# Copy to .env.production and replace every placeholder. Never commit that file.
APP_DB_PASSWORD=replace_with_url_safe_application_password
APP_DB_ROOT_PASSWORD=replace_with_strong_root_password

# Read-only collector account. Select only one location pattern:
# VM host: mysql+pymysql://readonly_user:replace_me@host.docker.internal:3306/opcua_collector
# Network host: mysql+pymysql://readonly_user:replace_me@192.0.2.10:3306/opcua_collector
# Shared Docker network: mysql+pymysql://readonly_user:replace_me@collector-db:3306/opcua_collector
SOURCE_DATABASE_URL=mysql+pymysql://readonly_user:replace_me@host.docker.internal:3306/opcua_collector

HTTP_PORT=80
CORS_ORIGINS=http://recipecontrol.example.internal
LOG_LEVEL=INFO
STALE_JOB_TIMEOUT_SECONDS=300
HISTORICAL_JOB_MAX_ATTEMPTS=3
HISTORICAL_PERSISTENCE_LEASE_SECONDS=900
ENABLE_LIVE_MODE=false
