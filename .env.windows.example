# Copy this file to .env on the Windows VM. Never commit .env.

# Writable RecipeControl application database and account.
APP_DATABASE_URL=mysql+pymysql://recipecontrol_app:replace_with_url_encoded_password@127.0.0.1:3306/recipecontrol

# The collector account must have SELECT only on its collector schema.
SOURCE_ADAPTER=mysql
SOURCE_DATABASE_URL=mysql+pymysql://recipecontrol_reader:replace_with_url_encoded_password@127.0.0.1:3306/opcua_collector

# FastAPI serves the production React build from this directory.
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=frontend/dist
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

MAX_ANALYSIS_DAYS=45
MAX_TREND_LOOKBACK_MINUTES=1440
NOTE_MAX_LENGTH=4000
LOG_LEVEL=INFO
STALE_JOB_TIMEOUT_SECONDS=300
HISTORICAL_JOB_MAX_ATTEMPTS=3
HISTORICAL_PERSISTENCE_LEASE_SECONDS=900

# Historical mode is the supported MVP. Keep live mode disabled.
ENABLE_LIVE_MODE=false
VITE_API_URL=/api
VITE_ENABLE_LIVE_MODE=false
